@model JobTracker.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h2 class="mb-4">Welcome back, @Model.UserName!</h2>

    <!-- Summary Cards -->
    @{
        var total = Model.TotalApplications;
        var appliedPct = total > 0 ? Math.Round((double)Model.AppliedCount / total * 100, 0) : 0;
        var interviewPct = total > 0 ? Math.Round((double)Model.InterviewCount / total * 100, 0) : 0;
        var offerPct = total > 0 ? Math.Round((double)Model.OfferCount / total * 100, 0) : 0;
        var rejectedPct = total > 0 ? Math.Round((double)Model.RejectedCount / total * 100, 0) : 0;
    }
    <div class="row g-3 mb-4">
        <div class="col-6 col-md">
            <a asp-controller="JobApplications" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-primary h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">Total</div>
                                <div class="display-5 fw-bold mb-0">@Model.TotalApplications</div>
                                <div class="opacity-75 small">View all applications</div>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md">
            <a asp-controller="JobApplications" asp-action="Index" asp-route-status="Applied" class="text-decoration-none">
                <div class="card text-white bg-info h-100 shadow-sm">
                    <div class="card-body">
                        <div class="fw-semibold">Applied</div>
                        <div class="display-5 fw-bold mb-0">@Model.AppliedCount</div>
                        <div class="opacity-75 small">@appliedPct% of total</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md">
            <a asp-controller="JobApplications" asp-action="Index" asp-route-status="Interview" class="text-decoration-none">
                <div class="card text-dark bg-warning h-100 shadow-sm">
                    <div class="card-body">
                        <div class="fw-semibold">Interview</div>
                        <div class="display-5 fw-bold mb-0">@Model.InterviewCount</div>
                        <div class="opacity-75 small">@interviewPct% of total</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md">
            <a asp-controller="JobApplications" asp-action="Index" asp-route-status="Offer" class="text-decoration-none">
                <div class="card text-white bg-success h-100 shadow-sm">
                    <div class="card-body">
                        <div class="fw-semibold">Offers</div>
                        <div class="display-5 fw-bold mb-0">@Model.OfferCount</div>
                        <div class="opacity-75 small">@offerPct% of total</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md">
            <a asp-controller="JobApplications" asp-action="Index" asp-route-status="Rejected" class="text-decoration-none">
                <div class="card text-white bg-danger h-100 shadow-sm">
                    <div class="card-body">
                        <div class="fw-semibold">Rejected</div>
                        <div class="display-5 fw-bold mb-0">@Model.RejectedCount</div>
                        <div class="opacity-75 small">@rejectedPct% of total</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Tracking & Schedule -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100 border-warning">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📅 Upcoming Interviews</h5>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingInterviews.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.UpcomingInterviews)
                            {
                                <a asp-controller="JobApplications" asp-action="Edit" asp-route-id="@item.JobApplicationId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold">@item.CompanyName</div>
                                        <small>@item.Position</small>
                                    </div>
                                    <span class="badge bg-dark rounded-pill">
                                        @(item.InterviewDate?.ToString("MMM dd") ?? "TBD")
                                    </span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">No upcoming interviews scheduled.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 border-info">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🔔 Follow-up Reminders</h5>
                </div>
                <div class="card-body">
                    @if (Model.PendingFollowUps.Any())
                    {
                        var today = DateTime.Today;
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.PendingFollowUps)
                            {
                                var followUpDate = item.FollowUpDate?.Date;
                                var badgeClass = followUpDate.HasValue && followUpDate.Value < today
                                    ? "bg-danger"
                                    : followUpDate.HasValue && followUpDate.Value == today
                                        ? "bg-warning text-dark"
                                        : "bg-secondary";

                                <a asp-controller="JobApplications" asp-action="Edit" asp-route-id="@item.JobApplicationId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold">@item.CompanyName</div>
                                        <small>@item.Position</small>
                                    </div>
                                    <span class="badge @badgeClass rounded-pill">
                                        @item.FollowUpDate?.ToString("MMM dd")
                                    </span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">No pending follow-ups.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics & Performance -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📈 Performance Metrics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4 mb-3">
                            <h6 class="text-muted">Success Rate</h6>
                            <div class="display-6 text-success">@Model.SuccessRate%</div>
                            <small class="text-muted">Applications to Offers</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <h6 class="text-muted">Response Rate</h6>
                            <div class="display-6 text-primary">@Model.ResponseRate%</div>
                            <small class="text-muted">Any Response Received</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <h6 class="text-muted">Avg Response Time</h6>
                            <div class="display-6 text-info">@Model.AverageResponseTimeDays</div>
                            <small class="text-muted">Days</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">📊 Applications per Month</h5>
                </div>
                <div class="card-body">
                    @if (Model.ApplicationsPerMonth.Any())
                    {
                        <canvas id="applicationsChart" width="400" height="200"></canvas>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">No application data available yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Applications -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Recent Applications (Last 5)</h4>
                    <a asp-controller="JobApplications" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Company</th>
                                    <th>Position</th>
                                    <th>Status</th>
                                    <th>Date Applied</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model.RecentApplications)
                                {
                                    <tr>
                                        <td>@job.CompanyName</td>
                                        <td>@job.Position</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(job.Status)">
                                                @job.Status
                                            </span>
                                        </td>
                                        <td>@job.AppliedDate.ToShortDateString()</td>
                                        <td>
                                            <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@job.JobApplicationId" class="btn btn-sm btn-info">Details</a>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.RecentApplications.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4">No applications found. <a asp-controller="JobApplications" asp-action="Create">Add your first job application!</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(JobTracker.Models.ApplicationStatus status)
    {
        return status switch
        {
            JobTracker.Models.ApplicationStatus.Applied => "bg-primary",
            JobTracker.Models.ApplicationStatus.Interview => "bg-warning text-dark",
            JobTracker.Models.ApplicationStatus.Offer => "bg-success",
            JobTracker.Models.ApplicationStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var ctx = document.getElementById('applicationsChart');
            if (ctx) {
                var chartData = @Html.Raw(Json.Serialize(Model.ApplicationsPerMonth));
                var labels = Object.keys(chartData);
                var data = Object.values(chartData);

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: '# of Applications',
                            data: data,
                            backgroundColor: 'rgba(54, 162, 235, 0.6)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
            }
        });
    </script>
}
