@model JobTracker.Models.ViewModels.SuperUserNotificationsViewModel

@{
    ViewData["Title"] = "Global Notifications";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Global Notifications</h2>
        <a asp-controller="SuperUser" asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>

    <div class="card mb-4">
        <div class="card-header">Send Notification</div>
        <div class="card-body">
            <form asp-controller="SuperUser" asp-action="Notifications" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea name="message" class="form-control" rows="3" required>@Model.Message</textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Starts At</label>
                        <input name="startsAtUtc" class="form-control" type="datetime-local" value="@(Model.StartsAtUtc?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ends At (optional)</label>
                        <input name="endsAtUtc" class="form-control" type="datetime-local" value="@(Model.EndsAtUtc?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Send</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Recent Notifications</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Created</th>
                            <th>Message</th>
                            <th>Starts</th>
                            <th>Ends</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Notifications)
                    {
                        <tr>
                            <td>@row.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@row.Message</td>
                            <td>@row.StartsAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(row.EndsAtUtc.HasValue ? row.EndsAtUtc.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                            <td>
                                @if (row.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (row.IsActive)
                                {
                                    <form asp-controller="SuperUser" asp-action="DeactivateNotification" asp-route-id="@row.GlobalNotificationId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Notifications.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">No notifications yet.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
