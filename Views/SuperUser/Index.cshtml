@model JobTracker.Models.ViewModels.SuperUserUsersViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Platform Statistics</h2>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">Total Users</div>
                <div class="card-body">
                    <h5 class="card-title display-6">@Model.Stats.TotalUsers</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-header">Total Applications Logged</div>
                <div class="card-body">
                    <h5 class="card-title display-6">@Model.Stats.TotalApplications</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-header">Total Interviews</div>
                <div class="card-body">
                    <h5 class="card-title display-6">@Model.Stats.TotalInterviews</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Total Offers</div>
                <div class="card-body">
                    <h5 class="card-title display-6">@Model.Stats.TotalOffers</h5>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">Applications This Month (@Model.Stats.CurrentMonthLabel)</div>
                <div class="card-body">
                    <h5 class="card-title display-6">@Model.Stats.ApplicationsThisMonth</h5>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">Average Applications Per User</div>
                <div class="card-body">
                    <h5 class="card-title display-6">@Model.Stats.AverageApplicationsPerUser</h5>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Most Active Users</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th>Name</th>
                            <th class="text-end">Total Applications</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.MostActiveUsers)
                    {
                        <tr>
                            <td>@row.Email</td>
                            <td>@row.Name</td>
                            <td class="text-end">@row.TotalApplications</td>
                        </tr>
                    }
                    @if (Model.MostActiveUsers.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4">No data yet.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Users</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Roles</th>
                    <th>Email Confirmed</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@($"{user.FirstName} {user.LastName}".Trim())</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>@(user.EmailConfirmed ? "Yes" : "No")</td>
                    <td>
                        @if (user.IsDisabled)
                        {
                            <span class="badge bg-danger">Disabled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-controller="SuperUser" asp-action="Activity" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Activity</a>

                        @if (user.IsDisabled)
                        {
                            <form asp-controller="SuperUser" asp-action="Enable" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Enable</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="SuperUser" asp-action="Disable" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">Disable</button>
                            </form>
                        }

                        <form asp-controller="SuperUser" asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
