@model IEnumerable<JobTracker.Models.JobApplication>

<h2>My Job Applications</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Job</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Company</th>
            <th>Position</th>
            <th>Status</th>
            <th>Date Applied</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var job in Model)
{
        <tr>
            <td>@job.CompanyName</td>
            <td>@job.Position</td>
            <td>@job.Status</td>
            <td>@job.AppliedDate.ToShortDateString()</td>
            <td>
                <a asp-action="Details"
                   asp-route-id="@job.JobApplicationId"
                   class="btn btn-sm btn-info">
                    Details
                </a>

                <a asp-action="Edit"
                   asp-route-id="@job.JobApplicationId"
                   class="btn btn-sm btn-warning">
                    Edit
                </a>

                <form asp-action="Delete"
                      asp-route-id="@job.JobApplicationId"
                      method="post"
                      style="display:inline;"
                      onsubmit="return confirm('Are you sure you want to delete this job application?');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-sm btn-danger">
                        Delete
                    </button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
