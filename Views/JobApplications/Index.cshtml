@model IEnumerable<JobTracker.Models.JobApplication>

<h2>My Job Applications</h2>

<a asp-action="Create">Add New Job</a>

<table>
    <thead>
        <tr>
            <th>Company</th>
            <th>Position</th>
            <th>Status</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
@foreach (var job in Model)
{
        <tr>
            <td>@job.CompanyName</td>
            <td>@job.Position</td>
            <td>@job.Status</td>
            <td>@job.AppliedDate.ToShortDateString()</td>
        </tr>
}
    </tbody>
</table>
