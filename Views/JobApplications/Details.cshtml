@model JobTracker.Models.JobApplication

<h2>Job Details</h2>

<p><strong>Company:</strong> @Model.CompanyName</p>
<p><strong>Position:</strong> @Model.Position</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Applied Date:</strong> @Model.AppliedDate.ToShortDateString()</p>

<a asp-action="Edit" asp-route-id="@Model.JobApplicationId">Edit</a> |
<a asp-action="Index">Back</a>
