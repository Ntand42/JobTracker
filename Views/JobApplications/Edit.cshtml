@model JobTracker.Models.JobApplication

<h2 class="mb-4">Edit Job Application</h2>

<form asp-action="Edit" method="post" class="needs-validation">
    @Html.AntiForgeryToken()
    @* Hidden field for the JobApplication ID *@
    <input type="hidden" asp-for="JobApplicationId" />

    <div class="mb-3">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Position" class="form-label"></label>
        <input asp-for="Position" class="form-control" />
        <span asp-validation-for="Position" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="JobType" class="form-label"></label>
        <input asp-for="JobType" class="form-control" placeholder="Full-time, Part-time, Internship..." />
        <span asp-validation-for="JobType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Add any notes or comments..."></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="JobLink" class="form-label"></label>
        <input asp-for="JobLink" class="form-control" placeholder="https://company.com/job/123" />
        <span asp-validation-for="JobLink" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ApplicationStatus>()"></select>
    </div>

    <div class="mb-4">
        <label asp-for="AppliedDate" class="form-label">Applied Date</label>
        <input asp-for="AppliedDate" class="form-control" type="date" />
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <label asp-for="InterviewDate" class="form-label">Interview Date</label>
            <input asp-for="InterviewDate" class="form-control" type="date" />
        </div>
        <div class="col-md-4">
            <label asp-for="FollowUpDate" class="form-label">Follow-up Date</label>
            <input asp-for="FollowUpDate" class="form-control" type="date" />
        </div>
        <div class="col-md-4">
            <label asp-for="OutcomeDate" class="form-label">Outcome Date</label>
            <input asp-for="OutcomeDate" class="form-control" type="date" />
        </div>
    </div>

    <button type="submit" class="btn btn-success">Save Job Application</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
